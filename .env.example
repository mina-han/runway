# 이 파일을 .env 로 복사해서 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 걸려 있어 커밋되지 않습니다. 값을 채운 뒤에도 절대 커밋하지 마세요.

# ── Anthropic API ─────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=

# ── Firestore 씨딩 (build/seed_firestore.py) ──────────────────────
# service account 키 파일 경로. 이 PC를 벗어나면 안 되는 관리자 권한 키입니다.
GOOGLE_APPLICATION_CREDENTIALS=

# Firestore 데이터베이스 이름. 기본 데이터베이스면 (default)
RUNWAY_DB=runway

# 대시보드를 여는 비밀번호. 이 값으로 데이터를 암호화합니다.
# 짧을수록 약합니다 — 긴 문구를 쓰면 코드 수정 없이 그대로 강해집니다.
RUNWAY_PASSWORD=
